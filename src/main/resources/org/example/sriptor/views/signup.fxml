<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="150.0" prefWidth="200.0" styleClass="parent" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.sriptor.controllers.SignupController">
    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="420.0" spacing="15.0" style="-fx-background-color: #f5f4ef; -fx-background-radius: 35;" styleClass="form" stylesheets="@style.css">
                    <children>
                        <HBox alignment="CENTER" prefHeight="60.0" prefWidth="360.0">
                            <children>
                                <Text fill="#3083dc" strokeType="OUTSIDE" strokeWidth="0.0" text="Create Account" textAlignment="CENTER">
                                    <font>
                                        <Font name="Satoshi Bold" size="30.0" />
                                    </font>
                                </Text>
                            </children>
                        </HBox>
                        <TextField fx:id="usernameField" prefHeight="45.0" prefWidth="360.0" promptText="First Name" styleClass="input-field" stylesheets="@style.css" />
                  <TextField prefHeight="45.0" prefWidth="360.0" promptText="Last Name" />
                        <PasswordField fx:id="passwordField" prefHeight="45.0" prefWidth="360.0" promptText="Password" styleClass="input-field" stylesheets="@style.css" />
                        <PasswordField fx:id="confirmPasswordField" prefHeight="45.0" prefWidth="360.0" promptText="Confirm Password" styleClass="input-field" stylesheets="@style.css" />
                        <ComboBox fx:id="roleComboBox" prefHeight="45.0" prefWidth="360.0" promptText="Select Role" styleClass="input-field" stylesheets="@style.css" />
                        <HBox alignment="CENTER" prefHeight="50.0" prefWidth="360.0">
                            <children>
                                <Button fx:id="signupButton" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #3083dc; -fx-background-radius: 8;" stylesheets="@style.css" text="Sign Up" textFill="WHITE">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="35.0" left="30.0" right="30.0" top="30.0" />
                    </padding>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>
